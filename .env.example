# Go to: Dashboard → API Keys → copy your key
# Free plan gives you 800 API calls/day (enough for 5-min bot)
TWELVEDATA_API_KEY=f51e0a137a424fb1848c2ec111cf8285

# ── TELEGRAM ────────────────────────────────────────────────────
# 1. Open Telegram → search @BotFather → send /newbot
# 2. Follow prompts → copy the token it gives you
# 3. Message your new bot (say "hi")
# 4. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 5. Find "chat":{"id": 123456789} — that number is your CHAT_ID
TELEGRAM_TOKEN=8610940250:AAGFSYGvawbHmT39k4dfL5H538SXV2Ifjkg
TELEGRAM_CHAT_ID=5498302916
